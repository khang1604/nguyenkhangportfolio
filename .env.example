# ==============================================================================
# Environment Configuration Template: NguyenKhangPortfolio
# Duplicate this file to .env or .env.local for local overrides.
# In Vite, client-exposed variables MUST be prefixed with VITE_
# ==============================================================================

# Application Meta
VITE_APP_TITLE="Nguyen Khang | Portfolio & Achievements"
VITE_APP_ENV="development" # development | staging | production
VITE_APP_BASE_URL="http://localhost:5173"

# Contact & Profile Information (Publicly safe defaults)
VITE_PROFILE_NAME="Nguyen Khang"
VITE_PROFILE_ROLE="Full Stack Engineer / AI Practitioner"
VITE_PROFILE_EMAIL="contact@example.com"
VITE_PROFILE_GITHUB="https://github.com/nguyenkhang"
VITE_PROFILE_LINKEDIN="https://linkedin.com/in/nguyenkhang"

# Logging & Telemetry Configuration
VITE_LOG_LEVEL="DEBUG" # DEBUG | INFO | WARN | ERROR
VITE_ENABLE_ANALYTICS=false
