.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx

# Dependencies & Package Stores
node_modules/
venv/
.venv/
env/
__pycache__/
*.py[cod]
.pnpm-store/
.npm/
.yarn/
.yarn-cache/

# Build Outputs, Bundles & Caches
dist/
dist-ssr/
build/
.next/
out/
coverage/
.turbo/
.cache/
.eslintcache
.stylelintcache
*.tsbuildinfo
.vite/

# Agent Tools & Knowledge Graph Artifacts
graphify-out/
.system_generated/
.task-observer/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Operating System Files & IDE Settings
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
